#!/bin/bash
# ==============================================================================
# VEILOS Application Sandbox Service: veil-run (Hardened Lifecycle Edition)
# Lifecycle States: CREATING -> RUNNING -> STOPPING -> DESTROYED (or ERROR)
# ==============================================================================

set -euo pipefail

PROFILES_DIR="${PROFILES_DIR:-/etc/veilos/profiles}"
SESSION_UID=$(id -u)
RUNTIME_BASE="${XDG_RUNTIME_DIR:-/tmp}/veilos-${SESSION_UID}"
USER_LOG_DIR="${RUNTIME_BASE}/logs"
ACTIVE_DIR="${RUNTIME_BASE}/active_workspaces"
WORKSPACES_DIR="${RUNTIME_BASE}/workspaces"
PROFILE=""
TIMEOUT_SECONDS=0
DRY_RUN=false

mkdir -p "$USER_LOG_DIR" "$ACTIVE_DIR" "$WORKSPACES_DIR"

log_event() {
    local event_type="$1"
    local message="$2"
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local log_entry="[$timestamp] [$event_type] $message"
    echo "$log_entry"
    echo "$log_entry" >> "${USER_LOG_DIR}/lifecycle.log" 2>/dev/null || true
}

update_lifecycle_state() {
    local new_state="$1"
    if [[ -f "$META_FILE" ]]; then
        sed -i "s/\"lifecycle_state\": \"[^\"]*\"/\"lifecycle_state\": \"$new_state\"/" "$META_FILE" 2>/dev/null || true
    fi
}

usage() {
    cat <<EOF
VEILOS Application Sandbox Service (veil-run)

Usage:
  veil-run --profile <profile-name> [OPTIONS]
  veil-run --list-profiles

Options:
  -p, --profile <name>       Predefined profile ID to launch
  --timeout <seconds>        Maximum runtime duration before automatic termination
  --dry-run                  Inspect generated sandbox command without execution
  -h, --help                 Show this help menu
EOF
    exit 0
}

# Parse Command Line Arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--profile)
            PROFILE="$2"; shift 2 ;;
        --timeout)
            TIMEOUT_SECONDS="$2"; shift 2 ;;
        --list-profiles)
            for p in "${PROFILES_DIR}"/*.json; do
                [[ -f "$p" ]] && grep -H '"name":' "$p"
            done
            exit 0 ;;
        --dry-run)
            DRY_RUN=true; shift ;;
        -h|--help)
            usage ;;
        *)
            echo "Unknown argument: $1" >&2
            usage ;;
    esac
done

if [[ -z "$PROFILE" ]]; then
    echo "Error: Missing required argument --profile <name>" >&2
    usage
fi

PROFILE_CONFIG="${PROFILES_DIR}/${PROFILE}.json"
if [[ ! -f "$PROFILE_CONFIG" ]]; then
    echo "Error: Profile '${PROFILE}' not recognized." >&2
    exit 1
fi

# Load Profile Configuration
PROFILE_NAME=$(grep -o '"name": "[^"]*' "$PROFILE_CONFIG" | cut -d'"' -f4)
EXECUTABLE=$(grep -o '"executable": "[^"]*' "$PROFILE_CONFIG" | cut -d'"' -f4)
NET_ENABLED=$(grep -o '"enabled": [^,]*' "$PROFILE_CONFIG" | head -n 1 | awk '{print $2}')
AUDIO_ENABLED=$(grep -o '"audio": [^,]*' "$PROFILE_CONFIG" | head -n 1 | awk '{print $2}')
MEM_LIMIT=$(grep -o '"memory_limit_mb": [0-9]*' "$PROFILE_CONFIG" | awk '{print $2}')

# Parse default_args safely
APP_ARGS=()
if command -v python3 >/dev/null 2>&1 && python3 -c "import json" >/dev/null 2>&1; then
    while IFS= read -r line; do
        [[ -n "$line" ]] && APP_ARGS+=("$line")
    done < <(python3 -c "import json; [print(x) for x in json.load(open('$PROFILE_CONFIG')).get('default_args', [])]")
else
    while IFS= read -r line; do
        [[ -n "$line" ]] && APP_ARGS+=("$line")
    done < <(sed -n '/"default_args"/,/]/p' "$PROFILE_CONFIG" | grep -o '"[^"]*"' | grep -v 'default_args' | tr -d '"')
fi

# Workspace Identification
WS_ID="veil_ws_${PROFILE}_$(date +%s)_${RANDOM}"
WS_DIR="${WORKSPACES_DIR}/${WS_ID}"
META_FILE="${ACTIVE_DIR}/${WS_ID}.json"

# State: CREATING
log_event "workspace_created" "Allocating environment [${WS_ID}] for '${PROFILE_NAME}'"

# Startup Validation & Error Trapping
trap 'cleanup_failed_startup' ERR

cleanup_failed_startup() {
    log_event "cleanup_failed" "Failed during workspace initialization for [${WS_ID}]"
    if [[ -f "$META_FILE" ]]; then
        update_lifecycle_state "ERROR"
    fi
    rm -rf "$WS_DIR" 2>/dev/null || true
    rm -f "$META_FILE" 2>/dev/null || true
    exit 1
}

mkdir -p "${WS_DIR}/Desktop" "${WS_DIR}/Downloads" "${WS_DIR}/Documents" "${WS_DIR}/.config" "${WS_DIR}/.cache"

# Build Bubblewrap Command
BWRAP_CMD=(
    bwrap
    --ro-bind /usr /usr
    --ro-bind /lib /lib
    --ro-bind-try /lib64 /lib64
    --ro-bind /bin /bin
    --ro-bind /sbin /sbin
    --ro-bind /etc /etc
    --ro-bind-try /opt /opt
    --tmpfs /tmp
    --tmpfs /var
    --proc /proc
    --dev /dev
    --bind "$WS_DIR" "$HOME"
    --unshare-pid
    --unshare-uts
    --unshare-ipc
    --hostname "veilos-${PROFILE}"
    --die-with-parent
)

if [[ "$NET_ENABLED" == "true" ]]; then
    BWRAP_CMD+=(--ro-bind-try /etc/resolv.conf /etc/resolv.conf)
else
    BWRAP_CMD+=(--unshare-net)
fi

if [[ "$AUDIO_ENABLED" == "true" ]]; then
    if [[ -d "/run/user/${SESSION_UID}/pulse" ]]; then
        BWRAP_CMD+=(--bind "/run/user/${SESSION_UID}/pulse" "/run/user/${SESSION_UID}/pulse")
    fi
    if [[ -S "/run/user/${SESSION_UID}/pipewire-0" ]]; then
        BWRAP_CMD+=(--bind "/run/user/${SESSION_UID}/pipewire-0" "/run/user/${SESSION_UID}/pipewire-0")
    fi
fi

if [[ -n "${DISPLAY:-}" ]]; then
    BWRAP_CMD+=(
        --setenv DISPLAY "$DISPLAY"
        --bind-try /tmp/.X11-unix /tmp/.X11-unix
        --ro-bind-try "$HOME/.Xauthority" "$HOME/.Xauthority"
    )
fi

# Dry Run Inspection
if [[ "$DRY_RUN" == "true" ]]; then
    echo "DRY-RUN: Command -> ${BWRAP_CMD[*]} ${EXECUTABLE} ${APP_ARGS[*]}"
    rm -rf "$WS_DIR" 2>/dev/null || true
    exit 0
fi

# Initial Metadata: CREATING
cat <<META > "$META_FILE"
{
  "id": "${WS_ID}",
  "profile": "${PROFILE}",
  "name": "${PROFILE_NAME}",
  "executable": "${EXECUTABLE}",
  "pid": $$,
  "workspace_path": "${WS_DIR}",
  "lifecycle_state": "CREATING",
  "created_at": $(date +%s)
}
META

# Lifecycle Cleanup Handler
cleanup_workspace() {
    # State: STOPPING
    update_lifecycle_state "STOPPING"
    log_event "workspace_stopped" "Workspace [${WS_ID}] terminating."
    
    # Terminate child processes bound to this workspace
    pkill -9 -f "${WS_ID}" 2>/dev/null || true
    
    # State: DESTROYED
    update_lifecycle_state "DESTROYED"
    if [[ -d "$WS_DIR" ]]; then
        find "$WS_DIR" -type f -exec shred -u -z -n 1 {} + 2>/dev/null || true
        rm -rf "$WS_DIR" 2>/dev/null || true
    fi
    rm -f "$META_FILE" 2>/dev/null || true
    log_event "workspace_destroyed" "Memory scrubbed and environment [${WS_ID}] destroyed."
}

trap cleanup_workspace EXIT INT TERM

# State: RUNNING
update_lifecycle_state "RUNNING"
log_event "workspace_started" "Application '${EXECUTABLE}' RUNNING inside sandbox [${WS_ID}]"

# Handle Optional Execution Timeout
if [[ "$TIMEOUT_SECONDS" -gt 0 ]]; then
    (
        sleep "$TIMEOUT_SECONDS"
        log_event "cleanup_triggered" "Workspace [${WS_ID}] reached execution timeout of ${TIMEOUT_SECONDS}s."
        pkill -TERM -f "${WS_ID}" 2>/dev/null || true
    ) &
fi

# Execute Sandbox
"${BWRAP_CMD[@]}" "${EXECUTABLE}" "${APP_ARGS[@]}"