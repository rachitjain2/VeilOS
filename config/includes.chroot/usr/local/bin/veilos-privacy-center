#!/usr/bin/env python3
"""
VEILOS Privacy Center
Non-technical, honest transparency dashboard displaying active system status,
application profiles, honest enforcement levels, and clear "Why?" policy explanations.
"""

import os
import sys
import subprocess
import glob
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

CSS_PATH = "/usr/share/veilos/dashboard/css/style.css"
VAULT_SERVICE = "/usr/local/bin/veilos-vault-service"

class VeilosPrivacyCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title="VEILOS Privacy Center")
        self.set_default_size(720, 780)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.get_style_context().add_class("veilos-window")

        self.apply_css()

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.add(scrolled)

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        main_box.set_margin_top(24)
        main_box.set_margin_bottom(24)
        main_box.set_margin_start(32)
        main_box.set_margin_end(32)
        scrolled.add(main_box)

        # 1. Header
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        header.set_halign(Gtk.Align.CENTER)
        
        t_lbl = Gtk.Label(label="PRIVACY CENTER")
        t_lbl.get_style_context().add_class("title-veil")
        header.pack_start(t_lbl, False, False, 0)

        sub_lbl = Gtk.Label(label="SYSTEM TRANSPARENCY & ENFORCEMENT AUDIT")
        sub_lbl.get_style_context().add_class("subtitle-veil")
        header.pack_start(sub_lbl, False, False, 0)
        main_box.pack_start(header, False, False, 0)

        # 2. System Status Section
        sec_sys_lbl = Gtk.Label(label="SYSTEM STATUS")
        sec_sys_lbl.get_style_context().add_class("status-label")
        sec_sys_lbl.set_halign(Gtk.Align.START)
        main_box.pack_start(sec_sys_lbl, False, False, 0)

        self.sys_status_box = self.build_system_status_panel()
        main_box.pack_start(self.sys_status_box, False, False, 0)

        # 3. Applications Section
        sec_app_lbl = Gtk.Label(label="APPLICATIONS")
        sec_app_lbl.get_style_context().add_class("status-label")
        sec_app_lbl.set_halign(Gtk.Align.START)
        main_box.pack_start(sec_app_lbl, False, False, 0)

        apps_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        # App 1: Private Browser
        app1 = self.build_app_card(
            name="Private Browser",
            policies=[
                ("Files", "BLOCKED", "✓ ENFORCED",
                 "This application does not receive a configured path to your personal files. Home is an ephemeral tmpfs mount."),
                ("Network", "ALLOWED", "✓ ENFORCED",
                 "Standard outbound DNS and web socket access is enabled to load remote web pages."),
                ("Persistence", "OFF", "✓ ENFORCED",
                 "All session caches, cookies, and history are held strictly in RAM and erased on exit.")
            ]
        )
        apps_box.pack_start(app1, False, False, 0)

        # App 2: Developer Workspace
        app2 = self.build_app_card(
            name="Developer Workspace",
            policies=[
                ("Files", "BLOCKED", "✓ ENFORCED",
                 "Host personal files and system binaries are masked or read-only. Workspace operates in isolated volatile directory."),
                ("Network", "ALLOWED", "✓ ENFORCED",
                 "Outbound network access is enabled so developers can pull packages (npm, pip, git clone)."),
                ("Persistence", "TEMPORARY", "✓ ENFORCED",
                 "Packages and scratch code exist in RAM only. Data is lost on exit unless pushed to remote Git or Secure Vault.")
            ]
        )
        apps_box.pack_start(app2, False, False, 0)

        # App 3: App Testing
        app3 = self.build_app_card(
            name="App Testing",
            policies=[
                ("Files", "BLOCKED", "✓ ENFORCED",
                 "Zero access to host personal files. Sandboxed processes execute inside an isolated jail."),
                ("Network", "ALLOWED", "✓ ENFORCED",
                 "Network interface is enabled for testing remote endpoints, but peripherals (camera/mic/USB) are blocked."),
                ("Persistence", "OFF", "✓ ENFORCED",
                 "No persistent storage. All modified files are shredded upon workspace destruction.")
            ]
        )
        apps_box.pack_start(app3, False, False, 0)

        main_box.pack_start(apps_box, False, False, 0)

        # 4. Legend & Limitations
        leg_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        leg_box.get_style_context().add_class("status-container")
        
        l_title = Gtk.Label(label="ENFORCEMENT AUDIT LEGEND & LIMITATIONS")
        l_title.get_style_context().add_class("status-label")
        l_title.set_halign(Gtk.Align.START)
        leg_box.pack_start(l_title, False, False, 0)

        l_desc = Gtk.Label(
            label="✓ ENFORCED — Cryptographically or kernel-namespace restricted.\n"
                  "◐ PARTIAL — Enforced by runtime masking; hardware side-channels not protected.\n"
                  "○ NOT IMPLEMENTED — Not enforceable in current MVP build."
        )
        l_desc.get_style_context().add_class("btn-desc")
        l_desc.set_halign(Gtk.Align.START)
        leg_box.pack_start(l_desc, False, False, 0)

        main_box.pack_start(leg_box, False, False, 0)

        # 5. Active Workspaces / Destroy All
        destroy_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        destroy_box.set_halign(Gtk.Align.CENTER)
        
        btn_nuke = Gtk.Button(label="DESTROY ALL ACTIVE WORKSPACES")
        btn_nuke.get_style_context().add_class("danger-btn")
        btn_nuke.connect("clicked", self.on_nuke_all)
        destroy_box.pack_start(btn_nuke, False, False, 0)

        btn_close = Gtk.Button(label="Close Privacy Center")
        btn_close.get_style_context().add_class("fallback-btn")
        btn_close.connect("clicked", lambda w: self.destroy())
        destroy_box.pack_start(btn_close, False, False, 0)

        main_box.pack_start(destroy_box, False, False, 0)

        GLib.timeout_add_seconds(2, self.update_system_status)

    def apply_css(self):
        if os.path.exists(CSS_PATH):
            provider = Gtk.CssProvider()
            provider.load_from_path(CSS_PATH)
            screen = Gdk.Screen.get_default()
            Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def build_system_status_panel(self):
        panel = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        panel.get_style_context().add_class("status-container")
        panel.set_homogeneous(True)

        # 1. Session
        b1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        l1 = Gtk.Label(label="Session")
        l1.get_style_context().add_class("status-label")
        self.val_session = Gtk.Label(label="TEMPORARY")
        self.val_session.get_style_context().add_class("status-val")
        b1.pack_start(l1, False, False, 0)
        b1.pack_start(self.val_session, False, False, 0)
        panel.pack_start(b1, True, True, 0)

        # 2. Persistence
        b2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        l2 = Gtk.Label(label="Persistence")
        l2.get_style_context().add_class("status-label")
        self.val_persist = Gtk.Label(label="OFF")
        self.val_persist.get_style_context().add_class("status-val")
        b2.pack_start(l2, False, False, 0)
        b2.pack_start(self.val_persist, False, False, 0)
        panel.pack_start(b2, True, True, 0)

        # 3. Application Sandboxing
        b3 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        l3 = Gtk.Label(label="Application Sandboxing")
        l3.get_style_context().add_class("status-label")
        self.val_sandbox = Gtk.Label(label="ACTIVE")
        self.val_sandbox.get_style_context().add_class("status-val")
        b3.pack_start(l3, False, False, 0)
        b3.pack_start(self.val_sandbox, False, False, 0)
        panel.pack_start(b3, True, True, 0)

        # 4. Network Policy
        b4 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        l4 = Gtk.Label(label="Network Policy")
        l4.get_style_context().add_class("status-label")
        self.val_net = Gtk.Label(label="ACTIVE")
        self.val_net.get_style_context().add_class("status-val")
        b4.pack_start(l4, False, False, 0)
        b4.pack_start(self.val_net, False, False, 0)
        panel.pack_start(b4, True, True, 0)

        return panel

    def update_system_status(self):
        # Check vault status
        if os.path.ismount("/media/veilos-vault"):
            self.val_persist.set_text("ON (VAULT UNLOCKED)")
            self.val_persist.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.2, 0.8, 0.4, 1.0))
        else:
            self.val_persist.set_text("OFF")
            self.val_persist.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.9, 0.6, 0.2, 1.0))

        # Check bwrap tool
        if os.path.exists("/usr/bin/bwrap"):
            self.val_sandbox.set_text("ACTIVE")
        else:
            self.val_sandbox.set_text("LIMITED")

        return True

    def build_app_card(self, name, policies):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class("action-btn")
        card.set_margin_start(2)
        card.set_margin_end(2)

        title_lbl = Gtk.Label(label=name)
        title_lbl.get_style_context().add_class("btn-title")
        title_lbl.set_halign(Gtk.Align.START)
        card.pack_start(title_lbl, False, False, 0)

        for dim, status, badge, reason in policies:
            row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            
            h_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            lbl_dim = Gtk.Label(label=f"{dim}: ")
            lbl_dim.get_style_context().add_class("pill-tag")
            
            lbl_stat = Gtk.Label(label=status)
            if status in ["BLOCKED", "OFF"]:
                lbl_stat.get_style_context().add_class("pill-blocked")
            elif status in ["ALLOWED", "ON"]:
                lbl_stat.get_style_context().add_class("pill-allowed")
            else:
                lbl_stat.get_style_context().add_class("pill-off")

            badge_lbl = Gtk.Label(label=f"[{badge}]")
            badge_lbl.get_style_context().add_class("card-badge")

            h_row.pack_start(lbl_dim, False, False, 0)
            h_row.pack_start(lbl_stat, False, False, 0)
            h_row.pack_start(badge_lbl, False, False, 0)
            row.pack_start(h_row, False, False, 0)

            # Why? explanation
            why_lbl = Gtk.Label(label=f'"{reason}"')
            why_lbl.get_style_context().add_class("btn-desc")
            why_lbl.set_halign(Gtk.Align.START)
            why_lbl.set_line_wrap(True)
            row.pack_start(why_lbl, False, False, 0)

            card.pack_start(row, False, False, 2)

        return card

    def on_nuke_all(self, widget):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text="Destroy All Running Environments?"
        )
        dialog.format_secondary_text(
            "This will terminate all processes inside active sandboxes and immediately scrub their temporary RAM contents."
        )
        res = dialog.run()
        dialog.destroy()
        if res == Gtk.ResponseType.OK:
            subprocess.run(["pkill", "-9", "-f", "bwrap"], check=False)
            uid = os.getuid()
            runtime_base = os.environ.get("XDG_RUNTIME_DIR", f"/tmp/veilos-{uid}")
            subprocess.run(f"rm -rf {runtime_base}/workspaces/*", shell=True, check=False)
            subprocess.run(f"rm -f {runtime_base}/active_workspaces/*.json", shell=True, check=False)

def main():
    win = VeilosPrivacyCenter()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()