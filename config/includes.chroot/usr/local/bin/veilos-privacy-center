    def apply_css(self):
        if os.path.exists(CSS_PATH):
            provider = Gtk.CssProvider()
            provider.load_from_path(CSS_PATH)
            screen = Gdk.Screen.get_default()
            if screen:
                Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def build_system_status_panel(self):
        panel = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        panel.get_style_context().add_class("status-container")
        panel.set_homogeneous(True)

        # 1. Session
        b1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        l1 = Gtk.Label(label="Session")
        l1.get_style_context().add_class("status-label")
        self.val_session = Gtk.Label(label="TEMPORARY")
        self.val_session.get_style_context().add_class("status-val")
        b1.pack_start(l1, False, False, 0)
        b1.pack_start(self.val_session, False, False, 0)
        panel.pack_start(b1, True, True, 0)

        # 2. Persistence
        b2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        l2 = Gtk.Label(label="Persistence")
        l2.get_style_context().add_class("status-label")
        self.val_persist = Gtk.Label(label="OFF")
        self.val_persist.get_style_context().add_class("status-val")
        b2.pack_start(l2, False, False, 0)
        b2.pack_start(self.val_persist, False, False, 0)
        panel.pack_start(b2, True, True, 0)

        # 3. Application Sandboxing
        b3 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        l3 = Gtk.Label(label="Application Sandboxing")
        l3.get_style_context().add_class("status-label")
        self.val_sandbox = Gtk.Label(label="ACTIVE")
        self.val_sandbox.get_style_context().add_class("status-val")
        b3.pack_start(l3, False, False, 0)
        b3.pack_start(self.val_sandbox, False, False, 0)
        panel.pack_start(b3, True, True, 0)

        # 4. Network Policy
        b4 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        l4 = Gtk.Label(label="Network Policy")
        l4.get_style_context().add_class("status-label")
        self.val_net = Gtk.Label(label="ACTIVE")
        self.val_net.get_style_context().add_class("status-val")
        b4.pack_start(l4, False, False, 0)
        b4.pack_start(self.val_net, False, False, 0)
        panel.pack_start(b4, True, True, 0)

        return panel

    def build_audit_log_panel(self):
        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        panel.get_style_context().add_class("status-container")

        sub = Gtk.Label(label="Zero private browsing contents, credentials, or sensitive payloads logged.")
        sub.get_style_context().add_class("btn-desc")
        sub.set_halign(Gtk.Align.START)
        panel.pack_start(sub, False, False, 2)

        self.audit_entries_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        panel.pack_start(self.audit_entries_box, False, False, 0)
        self.refresh_audit_entries()

        return panel

    def refresh_audit_entries(self):
        for child in self.audit_entries_box.get_children():
            self.audit_entries_box.remove(child)

        entries = load_audit_entries()
        for ts, ev_name, msg in entries:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            lbl_time = Gtk.Label(label=ts)
            lbl_time.get_style_context().add_class("status-label")
            lbl_time.set_halign(Gtk.Align.START)
            row.pack_start(lbl_time, False, False, 0)

            badge = Gtk.Label(label=f"[{ev_name}]")
            badge.get_style_context().add_class("card-badge")
            row.pack_start(badge, False, False, 0)

            lbl_msg = Gtk.Label(label=msg)
            lbl_msg.get_style_context().add_class("status-val")
            lbl_msg.set_halign(Gtk.Align.START)
            row.pack_start(lbl_msg, True, True, 0)

            self.audit_entries_box.pack_start(row, False, False, 1)

        self.audit_entries_box.show_all()

    def refresh_live_workspaces(self):
        for child in self.live_workspaces_box.get_children():
            self.live_workspaces_box.remove(child)

        active = get_active_workspaces()
        if not active:
            empty_lbl = Gtk.Label(label="No active workspaces currently running in RAM.")
            empty_lbl.get_style_context().add_class("btn-desc")
            empty_lbl.set_halign(Gtk.Align.START)
            self.live_workspaces_box.pack_start(empty_lbl, False, False, 4)
        else:
            for ws in active:
                card = self.build_live_workspace_card(ws)
                self.live_workspaces_box.pack_start(card, False, False, 4)

        self.live_workspaces_box.show_all()

    def build_live_workspace_card(self, ws):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.get_style_context().add_class("controller-panel")

        ws_id = ws.get("id") or ws.get("workspaceId", "unknown")
        app_name = ws.get("name", "Application")
        exec_name = os.path.basename(ws.get("executable", "app"))
        status_val = ws.get("status", "RUNNING")
        runtime_id = ws.get("runtimeId", f"bwrap_{ws_id}")
        net_allowed = (str(ws.get("network")).lower() == "true")
        start_ts = ws.get("created_at") or ws.get("started_at") or time.time()
        start_str = time.strftime("%H:%M:%S", time.localtime(start_ts))
        elapsed_secs = int(time.time() - start_ts) if status_val == "RUNNING" else 0
        mins, secs = divmod(elapsed_secs, 60)
        hours, mins = divmod(mins, 60)
        duration_str = f"{hours:02d}:{mins:02d}:{secs:02d}"

        # Header Row
        h_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        t_lbl = Gtk.Label(label=f"● {status_val}: {app_name}")
        if status_val == "RUNNING":
            t_lbl.get_style_context().add_class("pill-running")
        else:
            t_lbl.get_style_context().add_class("pill-stopped")
        t_lbl.set_halign(Gtk.Align.START)
        h_row.pack_start(t_lbl, False, False, 0)

        id_lbl = Gtk.Label(label=f"ID: {ws_id}")
        id_lbl.get_style_context().add_class("status-label")
        h_row.pack_end(id_lbl, False, False, 0)
        card.pack_start(h_row, False, False, 0)

        # Policy & Telemetry Rows (Part 9 Specification)
        grid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        
        self.add_telemetry_row(grid, "APPLICATION", f"{app_name} ({exec_name})", "pill-allowed")
        self.add_telemetry_row(grid, "WORKSPACE ID", ws_id, "status-val")
        self.add_telemetry_row(grid, "RUNTIME", runtime_id, "status-val")
        self.add_telemetry_row(grid, "STATUS", status_val, "pill-running" if status_val == "RUNNING" else "pill-stopped")
        self.add_telemetry_row(grid, "FILESYSTEM POLICY", "BLOCKED [ENFORCED] (Host personal dirs masked)", "pill-allowed")
        
        net_label = "ALLOWED [ENFORCED] (Outbound web)" if net_allowed else "OFFLINE / AIR-GAPPED [ENFORCED]"
        self.add_telemetry_row(grid, "NETWORK POLICY", net_label, "pill-allowed" if net_allowed else "pill-blocked")
        self.add_telemetry_row(grid, "STORAGE POLICY", "VOLATILE RAM [ENFORCED] (Shredded on exit)", "pill-off")
        self.add_telemetry_row(grid, "DEVICE POLICY", "BLOCKED [ENFORCED] (Raw disks, Camera, Mic masked)", "pill-allowed")
        self.add_telemetry_row(grid, "START TIME", start_str, "status-val")
        self.add_telemetry_row(grid, "SESSION DURATION", duration_str, "status-val")

        card.pack_start(grid, False, False, 2)

        # Destroy button for this specific workspace
        btn_d = Gtk.Button(label=f"[ DESTROY WORKSPACE {ws_id} ]")
        btn_d.get_style_context().add_class("danger-btn")
        btn_d.connect("clicked", lambda w, target=ws_id: self.on_destroy_single(target))
        card.pack_start(btn_d, False, False, 4)

        return card

    def add_telemetry_row(self, container, label_text, val_text, val_class):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl = Gtk.Label(label=f"{label_text}:")
        lbl.get_style_context().add_class("status-label")
        lbl.set_halign(Gtk.Align.START)
        
        val = Gtk.Label(label=val_text)
        val.get_style_context().add_class(val_class)
        val.set_halign(Gtk.Align.END)

        row.pack_start(lbl, False, False, 0)
        row.pack_end(val, False, False, 0)
        container.pack_start(row, False, False, 1)

    def on_destroy_single(self, target_id):
        subprocess.run([VEIL_RUN, "--destroy", target_id], check=False)
        self.refresh_live_workspaces()
        self.refresh_audit_entries()

    def update_system_status(self):
        if os.path.ismount("/media/veilos-vault"):
            self.val_persist.set_text("ON (VAULT UNLOCKED)")
            self.val_persist.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.2, 0.8, 0.4, 1.0))
        else:
            self.val_persist.set_text("OFF")
            self.val_persist.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.9, 0.6, 0.2, 1.0))

        if os.path.exists("/usr/bin/bwrap"):
            self.val_sandbox.set_text("ACTIVE")
        else:
            self.val_sandbox.set_text("LIMITED")

        self.refresh_live_workspaces()
        self.refresh_audit_entries()
        return True

    def build_app_card(self, name, policies):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class("action-btn")
        card.set_margin_start(2)
        card.set_margin_end(2)

        title_lbl = Gtk.Label(label=name)
        title_lbl.get_style_context().add_class("btn-title")
        title_lbl.set_halign(Gtk.Align.START)
        card.pack_start(title_lbl, False, False, 0)

        for dim, status, badge, reason in policies:
            row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            
            h_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            lbl_dim = Gtk.Label(label=f"{dim}: ")
            lbl_dim.get_style_context().add_class("pill-tag")
            
            lbl_stat = Gtk.Label(label=status)
            if status in ["BLOCKED", "OFF"]:
                lbl_stat.get_style_context().add_class("pill-blocked")
            elif status in ["ALLOWED", "ON"]:
                lbl_stat.get_style_context().add_class("pill-allowed")
            else:
                lbl_stat.get_style_context().add_class("pill-off")

            badge_lbl = Gtk.Label(label=f"[{badge}]")
            badge_lbl.get_style_context().add_class("card-badge")

            h_row.pack_start(lbl_dim, False, False, 0)
            h_row.pack_start(lbl_stat, False, False, 0)
            h_row.pack_start(badge_lbl, False, False, 0)
            row.pack_start(h_row, False, False, 0)

            # Why? explanation
            why_lbl = Gtk.Label(label=f'"{reason}"')
            why_lbl.get_style_context().add_class("btn-desc")
            why_lbl.set_halign(Gtk.Align.START)
            why_lbl.set_line_wrap(True)
            row.pack_start(why_lbl, False, False, 0)

            card.pack_start(row, False, False, 2)

        return card

    def on_nuke_all(self, widget):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text="Destroy All Running Environments?"
        )
        dialog.format_secondary_text(
            "This will terminate all processes inside active sandboxes and immediately scrub their temporary RAM contents."
        )
        res = dialog.run()
        dialog.destroy()
        if res == Gtk.ResponseType.OK:
            active = get_active_workspaces()
            for ws in active:
                ws_id = ws.get("id") or ws.get("workspaceId")
                if ws_id:
                    subprocess.run([VEIL_RUN, "--destroy", ws_id], check=False)

            subprocess.run(["pkill", "-9", "-f", "bwrap"], check=False)
            uid = os.getuid()
            runtime_base = os.environ.get("XDG_RUNTIME_DIR", f"/tmp/veilos-{uid}")
            subprocess.run(f"rm -rf {runtime_base}/workspaces/*", shell=True, check=False)
            subprocess.run(f"rm -f {runtime_base}/active_workspaces/*.json", shell=True, check=False)
            self.refresh_live_workspaces()
            self.refresh_audit_entries()


def main():
    win = VeilosPrivacyCenter()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
