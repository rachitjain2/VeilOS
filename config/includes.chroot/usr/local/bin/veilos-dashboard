    # Handlers for System Utilities
    def launch_vault(self):
        subprocess.Popen([VAULT_GUI])

    def launch_privacy_center(self):
        subprocess.Popen([PRIVACY_CENTER])

    def open_settings(self):
        SettingsDialog(self)

    def end_session(self):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.NONE,
            text="End this temporary session?"
        )
        dialog.format_secondary_text(
            "Temporary application environments will be terminated.\n"
            "All volatile workspace data will be permanently scrubbed."
        )
        dialog.add_button("CANCEL", Gtk.ResponseType.CANCEL)
        dialog.add_button("END SESSION", Gtk.ResponseType.OK)

        res = dialog.run()
        dialog.destroy()

        if res == Gtk.ResponseType.OK:
            # Step 1: Execute termination through session manager
            subprocess.run([VEIL_SESSION, "terminate"], check=False)
            
            # Step 2: Show confirmation
            info_dlg = Gtk.MessageDialog(
                transient_for=self,
                flags=0,
                message_type=Gtk.MessageType.INFO,
                buttons=Gtk.ButtonsType.OK,
                text="SESSION TERMINATED"
            )
            info_dlg.format_secondary_text(
                "All sandboxes halted. Temporary memory erased.\n"
                "Initiating system logout..."
            )
            info_dlg.run()
            info_dlg.destroy()

            # Step 3: Logout
            subprocess.Popen(["xfce4-session-logout", "--logout"])
            self.destroy()


def main():
    app = VeilosDashboard()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
