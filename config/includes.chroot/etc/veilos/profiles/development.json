{
  "profile_id": "development",
  "name": "DEVELOPER WORKSPACE",
  "badge": "DEV ENVIRONMENT",
  "description": "Code inside a disposable environment.",
  "toolchain_display": [
    "Node.js ✓",
    "Python ✓",
    "Git ✓",
    "npm ✓",
    "pip ✓"
  ],
  "executable": "/usr/local/bin/veilos-dev-starter",
  "default_args": [],
  "filesystem_policy": {
    "root_access": "read-only",
    "user_home": "isolated-tmpfs",
    "block_host_files": true,
    "allow_system_fonts": true,
    "allow_tmp": true,
    "writable_npm_cache": true,
    "writable_pip_cache": true
  },
  "network_policy": {
    "enabled": true,
    "configurable": true,
    "dns": "system"
  },
  "storage_policy": {
    "persistent_storage": false,
    "vault_access": false
  },
  "device_policy": {
    "audio": false,
    "camera": false,
    "microphone": false
  },
  "resource_policy": {
    "memory_limit_mb": 4096,
    "cpu_quota_percent": 95,
    "max_pids": 1024
  }
}