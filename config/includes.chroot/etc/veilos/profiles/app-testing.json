{
  "id": "app-testing",
  "profile_id": "app-testing",
  "name": "App Testing",
  "description": "Run software inside a disposable zero-trust environment.",
  "application": "Isolated Test Terminal / Runtime Jail",
  "executable": "/usr/local/bin/veilos-app-testing-starter",
  "arguments": [],
  "default_args": [],
  "permissions_display": {
    "Files": "BLOCKED (ENFORCED)",
    "Camera": "BLOCKED (ENFORCED)",
    "Microphone": "BLOCKED (ENFORCED)",
    "USB": "BLOCKED (ENFORCED)",
    "Network": "BLOCKED (ENFORCED)",
    "Storage": "TEMPORARY (ENFORCED)"
  },
  "filesystemPolicy": {
    "hostFiles": false,
    "temporaryHome": true,
    "readOnlySystem": true,
    "allowFonts": true,
    "allowTmp": true,
    "bindMounts": []
  },
  "filesystem_policy": {
    "root_access": "read-only",
    "user_home": "isolated-tmpfs",
    "block_host_files": true,
    "allow_system_fonts": true,
    "allow_tmp": true
  },
  "networkPolicy": {
    "internet": false,
    "dns": "none"
  },
  "network_policy": {
    "enabled": false,
    "dns": "none"
  },
  "devicePolicy": {
    "camera": "blocked",
    "microphone": "blocked",
    "usb": "blocked",
    "audio": "blocked",
    "hostDevices": "blocked"
  },
  "device_policy": {
    "audio": false,
    "camera": false,
    "microphone": false,
    "usb": false
  },
  "storagePolicy": {
    "persistent": false,
    "vaultAccess": false
  },
  "storage_policy": {
    "persistent_storage": false,
    "vault_access": false
  },
  "resourceLimits": {
    "maxCpuCores": 2,
    "maxMemoryMb": 1024,
    "maxPids": 128,
    "maxStorageMb": 512
  },
  "resource_policy": {
    "memory_limit_mb": 1024,
    "cpu_quota_percent": 50,
    "max_pids": 128
  },
  "cleanupPolicy": {
    "autoPurgeOnExit": true,
    "shredVolatileMemory": true
  }
}