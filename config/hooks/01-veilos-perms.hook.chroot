#!/bin/bash
set -e
echo "=== [VEILOS Live Hook] Setting permissions & user environment ==="
chmod 755 /usr/local/bin/veilos-* 2>/dev/null || true
chmod 755 /usr/local/bin/veil-* 2>/dev/null || true
chmod 440 /etc/sudoers.d/veilos 2>/dev/null || true
chown root:root /etc/sudoers.d/veilos 2>/dev/null || true
chmod 755 /etc/skel/Desktop/*.desktop 2>/dev/null || true

echo "=== [VEILOS Live Hook] Creating autologin group and veilos user ==="
groupadd -r autologin 2>/dev/null || true
groupadd -r sudo 2>/dev/null || true

if ! id -u veilos >/dev/null 2>&1; then
    useradd -m -s /bin/bash -u 1000 -g users -G sudo,autologin,video,audio,cdrom,plugdev,netdev,powerdev veilos 2>/dev/null || true
else
    usermod -a -G sudo,autologin,video,audio,cdrom,plugdev,netdev,powerdev veilos 2>/dev/null || true
fi

# Set explicit passwords
echo "veilos:veilos" | chpasswd 2>/dev/null || true
echo "root:root" | chpasswd 2>/dev/null || true
passwd -u veilos 2>/dev/null || true
passwd -u root 2>/dev/null || true

# Allow blank password logins in PAM
if [ -f /etc/pam.d/common-auth ]; then
    sed -i 's/pam_unix.so\(.*\)nullok/pam_unix.so\1/' /etc/pam.d/common-auth 2>/dev/null || true
    sed -i 's/pam_unix.so/pam_unix.so nullok/' /etc/pam.d/common-auth 2>/dev/null || true
fi

# Full passwordless sudo for veilos
echo "veilos ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/01-veilos-nopasswd
chmod 440 /etc/sudoers.d/01-veilos-nopasswd

# Setup home directory with full skel
mkdir -p /home/veilos/Desktop
cp -a /etc/skel/. /home/veilos/ 2>/dev/null || true
chown -R 1000:100 /home/veilos 2>/dev/null || true
chmod -R 755 /home/veilos/Desktop 2>/dev/null || true

echo "=== [VEILOS Live Hook] Configuring Direct Graphical Boot (LightDM/XFCE) ==="
systemctl set-default graphical.target 2>/dev/null || true
ln -sf /lib/systemd/system/graphical.target /etc/systemd/system/default.target 2>/dev/null || true
systemctl enable lightdm 2>/dev/null || true
ln -sf /lib/systemd/system/lightdm.service /etc/systemd/system/display-manager.service 2>/dev/null || true

# Configure LightDM autologin
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/01-autologin.conf << 'EOF'
[Seat:*]
autologin-guest=false
autologin-user=veilos
autologin-user-timeout=0
autologin-session=xfce
user-session=xfce
greeter-session=lightdm-gtk-greeter
greeter-hide-users=false
EOF

cat > /etc/lightdm/lightdm.conf << 'EOF'
[Seat:*]
autologin-guest=false
autologin-user=veilos
autologin-user-timeout=0
autologin-session=xfce
user-session=xfce
greeter-session=lightdm-gtk-greeter
greeter-hide-users=false
EOF

# Ensure PAM allows LightDM autologin without any check
mkdir -p /etc/pam.d
cat > /etc/pam.d/lightdm-autologin << 'EOF'
#%PAM-1.0
auth    sufficient      pam_permit.so
auth    required        pam_env.so
account sufficient      pam_permit.so
password sufficient     pam_permit.so
session sufficient      pam_permit.so
EOF

# Ensure TTY1 autologins and auto-runs startx as secondary fallback
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf << 'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin veilos --noclear %I $TERM
Type=idle
EOF

echo "=== [VEILOS Live Hook] Completed successfully ==="
